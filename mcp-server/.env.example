# ── MCP Server Configuration ──────────────────────────────────────────────────
MCP_PORT=3001
MCP_BASE_URL=http://localhost:3001

# ── Supabase Configuration ────────────────────────────────────────────────────
# These are the SAME Supabase instance as the frontend uses.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SERVER-SIDE ONLY — never expose in browser / VITE_ vars
# Required for admin operations (user lookup from access tokens).
SUPABASE_SERVICE_ROLE_KEY=

